# Copy to keystore.properties and fill in. That file is gitignored -- it holds the passwords
# to the key that signs every release, and the key itself must stay out of the repository.
#
# Create the keystore once (see README, "Release signing"). Keep a backup somewhere safe:
# lose it and you can never publish an update that installs over the current one.

storeFile=/absolute/path/to/karoo-bignum.jks
storePassword=
keyAlias=karoo-bignum
keyPassword=
