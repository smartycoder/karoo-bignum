<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_bignum"
        android:allowBackup="false">

        <service
            android:name=".BigNumExtension"
            android:exported="true"
            android:permission="io.hammerhead.karoo.SYSTEM_ID">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION"/>
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info"/>
        </service>
    </application>
</manifest>
