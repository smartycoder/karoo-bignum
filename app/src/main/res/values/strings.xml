    <string name="setting_zone_colors">Zone colors</string>
    <string name="setting_zone_mode_off">Off</string>
    <string name="setting_zone_mode_text">Number</string>
    <string name="setting_zone_mode_fill">Field background</string>
    <string name="setting_zone_colors_desc">Color heart rate and power by your Karoo zones. Number colors the value itself; Field background fills the whole field and sets the number in black or white.</string>
    <string name="setting_font">Font</string>
    <string name="setting_font_oswald">Oswald</string>
    <string name="setting_font_saira">Saira</string>
    <string name="setting_font_width">Width</string>
    <string name="setting_font_weight">Weight</string>
    <string name="setting_font_desc">Saira has equal-width digits, so a value stops shifting sideways, and it can be set narrower — which makes the number taller. Width and weight apply to Saira only. Labels stay in Oswald.</string>
    <string name="setting_raised_tail">Raised decimals</string>
    <string name="setting_raised_tail_desc">Decimals and ride-time seconds drawn small and raised: 34⁹, 1:34¹⁷. Dropping the point leaves the number more room.</string>

    <string name="setting_test_mode">Test mode</string>
    <string name="setting_test_mode_desc">Show demo values in every field instead of live data. For screenshots and layout checks. Debug builds only.</string>

