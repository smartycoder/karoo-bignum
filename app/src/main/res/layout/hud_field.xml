<?xml version="1.0" encoding="utf-8"?>
<!--
  The HUD tile: two whole BigNum fields side by side, each in its own half, with an optional
  zone bar along the top.

  Both FrameLayouts stay EMPTY here on purpose: they are containers that HudField fills at
  runtime with RemoteViews.addView, one numeric_field.xml per slot. Nothing in this file may
  assume what ends up inside them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      A sibling of the bar, not a child below it, and it keeps the WHOLE tile height. The contract
      that makes that safe is stated once, on FieldRenderer.render's overlayTopPx.

      It carries no id because nothing addresses it: an earlier design padded this row from
      HudField, and that is what cost both numbers the bar's full height whether they needed it
      or not.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout android:id="@+id/slot_left"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <!--
          A fixed mid grey rather than a theme-aware colour: this project has no values-night/ at
          all (everything else resolves light/dark in code via Theme.isNight), and #808080 holds
          its own against both the white and the black card. The divider sits OUTSIDE both slot
          containers, so a slot filled with its zone colour under ZoneColorMode.FILL paints only
          its own half and leaves this line untouched.

          An ImageView and not a bare View, which is the obvious choice for a rule and does not
          work: RemoteViews inflates only the classes on its own allow list, and android.view.View
          is not one of them. A plain View here threw
          "Class not allowed to be inflated android.view.View" on the device while every JVM test
          still passed, because nothing off-device inflates this file.

          EDGE TO EDGE, with no margins, and the top end is left to the pill rather than to a
          margin. It used to be inset by field_edge_padding at both ends so the rule stopped where
          each half's content stops; run to the edges it reads as the tile's own division rather
          than as a floating tick.

          The row runs the full height of the tile, so this line passes BEHIND the zone pill, and
          the pill is opaque: with a bar configured the rule appears to begin just under it, and
          with no bar it reaches the top edge. That is the whole of the rule's top behaviour, and
          it needs no code. That is why renderZonePill painting an opaque ground before its
          translucent track is load bearing rather than cosmetic. Without it this grey line showed
          through the pill and blinked in and out.
        -->
        <ImageView
            android:layout_width="@dimen/hud_divider_width"
            android:layout_height="match_parent"
            android:background="#808080"
            android:contentDescription="@null"/>

        <FrameLayout android:id="@+id/slot_right"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

    </LinearLayout>

    <!--
      The zone pill. wrap_content and scaleType="center", NOT match_parent with fitXY: the bitmap
      is drawn at exactly the size it wants to occupy, so any scaling here would be the view
      second-guessing arithmetic that already accounts for the icon, the squares and the value.
      fitXY on a content-sized pill stretched a 250px lozenge across the whole tile.

      top|center_horizontal puts it in the middle of the header row, where it straddles the
      divider between the two halves and has the space between the two labels to itself.

      It sits INSIDE the row both slots already reserve for their header, so it takes no height
      from either number. That is the whole reason the previous full-width bar had to be laid
      over the tile and reasoned about with an overlay, and this one does not.
    -->
    <ImageView android:id="@+id/hud_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/hud_pill_inset"
        android:scaleType="center"
        android:visibility="gone"
        android:contentDescription="@null"/>

</FrameLayout>
